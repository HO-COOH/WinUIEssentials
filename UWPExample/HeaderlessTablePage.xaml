<Page
    x:Class="UWPExample.HeaderlessTablePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:UWPPackage"
    xmlns:local="using:UWPExample"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <local:ControlExample
        Grid.Row="1"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        HeaderText="Table demo">
        <essential:Table
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            CornerRadius="{StaticResource ControlCornerRadius}"
            HeaderBackground="{ThemeResource ControlFillColorDefault}"
            HeaderFontWeight="Normal">
            <essential:Table.ItemsSource>
                <local:DemoTableData />
            </essential:Table.ItemsSource>
            <!--  All column contents are empty, so the table renders headerless.  -->
            <essential:Table.Columns>
                <essential:TableColumn />
                <essential:TableColumn />
                <essential:TableColumn />
                <essential:TableColumn />
                <essential:TableColumn />
                <essential:TableColumn />
                <essential:TableColumn />
                <essential:TableColumn MinWidth="36">
                    <essential:TableColumn.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Value, Mode=TwoWay}" />
                        </DataTemplate>
                    </essential:TableColumn.ItemTemplate>
                </essential:TableColumn>
                <essential:TableColumn />
                <essential:TableColumn />
                <essential:TableColumn>
                    <essential:TableColumn.EditTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBox Text="{x:Bind}" />
                        </DataTemplate>
                    </essential:TableColumn.EditTemplate>
                </essential:TableColumn>
            </essential:Table.Columns>
        </essential:Table>

        <local:ControlExample.Xaml>
            <local:CodeSource>
                <local:CodeSource.Code>
                    <x:String xml:space="preserve">&lt;essential:Table
    x:Name=&quot;DemoTable&quot;
    HorizontalAlignment=&quot;Stretch&quot;
    VerticalAlignment=&quot;Stretch&quot;
    CornerRadius=&quot;{StaticResource ControlCornerRadius}&quot;
    HeaderBackground=&quot;{ThemeResource ControlFillColorDefault}&quot;
    HeaderFontWeight=&quot;Normal&quot;&gt;
    &lt;essential:Table.ItemsSource&gt;
        &lt;local:DemoTableData /&gt;
    &lt;/essential:Table.ItemsSource&gt;
    &lt;!--  All column contents are empty, so the table renders headerless.  --&gt;
    &lt;essential:Table.Columns&gt;
        &lt;essential:TableColumn /&gt;
        &lt;essential:TableColumn /&gt;
        &lt;essential:TableColumn /&gt;
        &lt;essential:TableColumn /&gt;
        &lt;essential:TableColumn /&gt;
        &lt;essential:TableColumn /&gt;
        &lt;essential:TableColumn /&gt;
        &lt;essential:TableColumn&gt;
            &lt;essential:TableColumn.ItemTemplate&gt;
                &lt;DataTemplate&gt;
                    &lt;CheckBox IsChecked=&quot;{Binding Value, Mode=TwoWay}&quot; /&gt;
                &lt;/DataTemplate&gt;
            &lt;/essential:TableColumn.ItemTemplate&gt;
        &lt;/essential:TableColumn&gt;

        &lt;essential:TableColumn /&gt;
        &lt;essential:TableColumn /&gt;
        &lt;essential:TableColumn&gt;
            &lt;essential:TableColumn.EditTemplate&gt;
                &lt;DataTemplate x:DataType=&quot;x:String&quot;&gt;
                    &lt;TextBox Text=&quot;{x:Bind}&quot; /&gt;
                &lt;/DataTemplate&gt;
            &lt;/essential:TableColumn.EditTemplate&gt;
        &lt;/essential:TableColumn&gt;
    &lt;/essential:Table.Columns&gt;
&lt;/essential:Table&gt;</x:String>
                </local:CodeSource.Code>
            </local:CodeSource>
        </local:ControlExample.Xaml>
    </local:ControlExample>
</Page>
