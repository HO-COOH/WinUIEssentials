<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUI3Example.WindowExPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:WinUI3Example"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Style="{StaticResource ControlExamplesStackPanelStyle}">
        <local:ControlExample HeaderText="The simplest window, with a Win32 titlebar. Because WindowEx is a ContentControl, you can set its RequiredTheme. Then the titlebar background (inactive state) automatically sync with its Content's theme">
            <Button x:Name="CreateWin32Window" Click="CreateWin32Window_Click">Click to create window with win32 titlebar with automatic dark mode</Button>
            <local:ControlExample.Xaml>
                <local:CodeSource>
                    <local:CodeSource.Code>
                        <x:String xml:space="preserve">&lt;essential:WindowEx
    x:Class=&quot;WinUI3Example.Win32TitleBar&quot;
    xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;
    xmlns:x=&quot;http://schemas.microsoft.com/winfx/2006/xaml&quot;
    xmlns:d=&quot;http://schemas.microsoft.com/expression/blend/2008&quot;
    xmlns:essential=&quot;using:WinUI3Package&quot;
    xmlns:local=&quot;using:WinUI3Example&quot;
    xmlns:mc=&quot;http://schemas.openxmlformats.org/markup-compatibility/2006&quot;
    mc:Ignorable=&quot;d&quot;&gt;

    &lt;Grid Background=&quot;{ThemeResource SolidBackgroundFillColorBaseBrush}&quot;&gt;
        &lt;local:ThemeToggleButton
            HorizontalAlignment=&quot;Left&quot;
            VerticalAlignment=&quot;Bottom&quot;
            Root=&quot;{x:Bind}&quot; /&gt;

        &lt;TextBlock
            HorizontalAlignment=&quot;Center&quot;
            VerticalAlignment=&quot;Center&quot;
            Text=&quot;Some text&quot; /&gt;
    &lt;/Grid&gt;
&lt;/essential:WindowEx&gt;</x:String>
                    </local:CodeSource.Code>
                </local:CodeSource>
            </local:ControlExample.Xaml>
        </local:ControlExample>

        <local:ControlExample HeaderText="Since WindowEx is a DependencyObject, most of its dynamic settable properties are DependencyProperty, which can be targets of Storyboard animations">
            <Button x:Name="CreateAnimatedSizeWindow" Click="CreateAnimatedSizeWindow_Click">Click to create Window with animated width</Button>
            <local:ControlExample.Xaml>
                <local:CodeSource>
                    <local:CodeSource.Code>
                        <x:String xml:space="preserve">&lt;essential:WindowEx
    x:Class=&quot;WinUI3Example.AnimatedWindowSize&quot;
    xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;
    xmlns:x=&quot;http://schemas.microsoft.com/winfx/2006/xaml&quot;
    xmlns:d=&quot;http://schemas.microsoft.com/expression/blend/2008&quot;
    xmlns:essential=&quot;using:WinUI3Package&quot;
    xmlns:local=&quot;using:WinUI3Example&quot;
    xmlns:mc=&quot;http://schemas.openxmlformats.org/markup-compatibility/2006&quot;
    x:Name=&quot;RootWindow&quot;
    Title=&quot;AnimatedWindowSize&quot;
    Width=&quot;500&quot;
    Height=&quot;600&quot;
    mc:Ignorable=&quot;d&quot;&gt;

    &lt;Button
        HorizontalAlignment=&quot;Center&quot;
        VerticalAlignment=&quot;Center&quot;
        Click=&quot;Button_Click&quot;&gt;
        Click to animate window width
        &lt;Button.Resources&gt;
            &lt;Storyboard x:Name=&quot;WindowAnimation&quot;&gt;
                &lt;DoubleAnimation
                    EnableDependentAnimation=&quot;True&quot;
                    Storyboard.TargetName=&quot;RootWindow&quot;
                    Storyboard.TargetProperty=&quot;Width&quot;
                    From=&quot;500&quot;
                    To=&quot;1000&quot; /&gt;
            &lt;/Storyboard&gt;
        &lt;/Button.Resources&gt;
    &lt;/Button&gt;
&lt;/essential:WindowEx&gt;</x:String>
                    </local:CodeSource.Code>
                </local:CodeSource>
            </local:ControlExample.Xaml>

            <local:ControlExample.Cpp>
                <local:CodeSource>
                    <local:CodeSource.Code>
                        <x:String xml:space="preserve">	void winrt::WinUI3Example::implementation::AnimatedWindowSize::Button_Click(winrt::Windows::Foundation::IInspectable const&amp;, winrt::Microsoft::UI::Xaml::RoutedEventArgs const&amp;)
{
	WindowAnimation().Begin();
}</x:String>
                    </local:CodeSource.Code>
                </local:CodeSource>
            </local:ControlExample.Cpp>
        </local:ControlExample>

        <local:ControlExample HeaderText="Also, the majority of settable properties are DependencyProperty. Other readonly properties are notifying properties you can bind to">
            <Button x:Name="PropertyBindingSampleWindow" Click="PropertyBindingSampleWindow_Click">Demo WindowEx property bindings</Button>
            <local:ControlExample.Xaml>
                <local:CodeSource>
                    <local:CodeSource.Code>
                        <x:String xml:space="preserve">&lt;essential:WindowEx
    x:Class=&quot;WinUI3Example.PropertyBindingSampleWindow&quot;
    xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;
    xmlns:x=&quot;http://schemas.microsoft.com/winfx/2006/xaml&quot;
    xmlns:d=&quot;http://schemas.microsoft.com/expression/blend/2008&quot;
    xmlns:essential=&quot;using:WinUI3Package&quot;
    xmlns:local=&quot;using:WinUI3Example&quot;
    xmlns:mc=&quot;http://schemas.openxmlformats.org/markup-compatibility/2006&quot;
    Title=&quot;PropertyBindingSampleWindow&quot;
    mc:Ignorable=&quot;d&quot;&gt;

    &lt;StackPanel
        HorizontalAlignment=&quot;Center&quot;
        VerticalAlignment=&quot;Center&quot;
        Spacing=&quot;8&quot;&gt;
        &lt;ToggleSwitch
            x:Name=&quot;ExtendsContentIntoTitleBarToggle&quot;
            Header=&quot;ExtendsContentIntoTitleBar&quot;
            IsOn=&quot;{x:Bind ExtendsContentIntoTitleBar, Mode=TwoWay}&quot; /&gt;
        &lt;TextBlock&gt;
            &lt;Run&gt;Dpi:&lt;/Run&gt;
            &lt;Run Text=&quot;{x:Bind Dpi, Mode=OneWay}&quot; /&gt;
        &lt;/TextBlock&gt;
        &lt;TextBlock&gt;
            &lt;Run&gt;Raw Size:&lt;/Run&gt;
            &lt;Run Text=&quot;{x:Bind RawWidth, Mode=OneWay}&quot; /&gt;
            &lt;Run&gt;,&lt;/Run&gt;
            &lt;Run Text=&quot;{x:Bind RawHeight, Mode=OneWay}&quot; /&gt;
        &lt;/TextBlock&gt;
        &lt;CheckBox Content=&quot;HasTitleBar&quot; IsChecked=&quot;{x:Bind HasTitleBar, Mode=TwoWay}&quot; /&gt;
        &lt;CheckBox Content=&quot;IsResizable&quot; IsChecked=&quot;{x:Bind IsResizable, Mode=TwoWay}&quot; /&gt;
        &lt;CheckBox Content=&quot;IsAlwaysOnTop&quot; IsChecked=&quot;{x:Bind IsAlwaysOnTop, Mode=TwoWay}&quot; /&gt;
        &lt;CheckBox Content=&quot;IsShownInSwicther&quot; IsChecked=&quot;{x:Bind IsShownInSwitcher, Mode=TwoWay}&quot; /&gt;
    &lt;/StackPanel&gt;
&lt;/essential:WindowEx&gt;</x:String>
                    </local:CodeSource.Code>
                </local:CodeSource>
            </local:ControlExample.Xaml>
        </local:ControlExample>

        <local:ControlExample HeaderText="Custom titlebar content using WindowEx.NonClientRegionKind">
            <Button x:Name="CreateCustomWindow" Click="CreateCustomWindow_Click">Click to create window with custom titlebar</Button>
            <local:ControlExample.Xaml>
                <local:CodeSource>
                    <local:CodeSource.Code>
                        <x:String xml:space="preserve">&lt;Window
    x:Class=&quot;WinUI3Example.CustomTitleBar&quot;
    xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;
    xmlns:x=&quot;http://schemas.microsoft.com/winfx/2006/xaml&quot;
    xmlns:d=&quot;http://schemas.microsoft.com/expression/blend/2008&quot;
    xmlns:essential=&quot;using:WinUI3Package&quot;
    xmlns:mc=&quot;http://schemas.openxmlformats.org/markup-compatibility/2006&quot;
    mc:Ignorable=&quot;d&quot;&gt;

    &lt;Window.SystemBackdrop&gt;
        &lt;MicaBackdrop /&gt;
    &lt;/Window.SystemBackdrop&gt;

    &lt;Grid&gt;
        &lt;Grid.RowDefinitions&gt;
            &lt;RowDefinition Height=&quot;48&quot; /&gt;
            &lt;RowDefinition /&gt;
        &lt;/Grid.RowDefinitions&gt;

        &lt;essential:WindowCaptionButtonThemeWorkaround Window=&quot;{x:Bind}&quot; /&gt;
        &lt;Grid&gt;
            &lt;Grid.ColumnDefinitions&gt;
                &lt;!--  Left padding  --&gt;
                &lt;ColumnDefinition Width=&quot;10&quot; /&gt;

                &lt;!--  Icon column  --&gt;
                &lt;ColumnDefinition Width=&quot;Auto&quot; /&gt;

                &lt;!--  Title column  --&gt;
                &lt;ColumnDefinition Width=&quot;Auto&quot; /&gt;

                &lt;!--  drag area  --&gt;
                &lt;ColumnDefinition Width=&quot;*&quot; /&gt;

                &lt;!--  AutoSuggestBox column  --&gt;
                &lt;ColumnDefinition Width=&quot;4*&quot; MinWidth=&quot;220&quot; /&gt;

                &lt;!--  drag area  --&gt;
                &lt;ColumnDefinition Width=&quot;*&quot; MinWidth=&quot;48&quot; /&gt;

                &lt;!--  PersonPicture control  --&gt;
                &lt;ColumnDefinition Width=&quot;Auto&quot; /&gt;

                &lt;!--  drag area  --&gt;
                &lt;ColumnDefinition Width=&quot;140&quot; /&gt;
            &lt;/Grid.ColumnDefinitions&gt;
            &lt;Image
                Grid.Column=&quot;1&quot;
                Width=&quot;16&quot;
                Height=&quot;16&quot;
                Margin=&quot;8,0,16,0&quot;
                Source=&quot;ms-appx:///Assets/StoreLogo.png&quot; /&gt;
            &lt;TextBlock
                Grid.Column=&quot;2&quot;
                VerticalAlignment=&quot;Center&quot;
                Style=&quot;{StaticResource CaptionTextBlockStyle}&quot;
                Text=&quot;App title&quot; /&gt;
            &lt;AutoSuggestBox
                Grid.Column=&quot;4&quot;
                MaxWidth=&quot;600&quot;
                VerticalAlignment=&quot;Center&quot;
                essential:WindowEx.NonClientRegionKind=&quot;Passthrough&quot;
                PlaceholderText=&quot;Search&quot;
                QueryIcon=&quot;Find&quot; /&gt;
            &lt;StackPanel
                Grid.Column=&quot;6&quot;
                Margin=&quot;0,0,16,0&quot;
                essential:WindowEx.NonClientRegionKind=&quot;Passthrough&quot;
                Orientation=&quot;Horizontal&quot;
                Spacing=&quot;10&quot;&gt;
                &lt;ToggleButton&gt;Button on titlebar&lt;/ToggleButton&gt;
                &lt;PersonPicture Height=&quot;32&quot; PointerPressed=&quot;PersonPic_PointerPressed&quot;&gt;
                    &lt;PersonPicture.ContextFlyout&gt;
                        &lt;MenuFlyout&gt;
                            &lt;MenuFlyoutItem Text=&quot;Settings&quot; /&gt;
                            &lt;MenuFlyoutSeparator /&gt;
                            &lt;MenuFlyoutItem Text=&quot;About Me&quot; /&gt;
                        &lt;/MenuFlyout&gt;
                    &lt;/PersonPicture.ContextFlyout&gt;
                &lt;/PersonPicture&gt;
            &lt;/StackPanel&gt;
        &lt;/Grid&gt;

        &lt;StackPanel
            Grid.Row=&quot;1&quot;
            HorizontalAlignment=&quot;Center&quot;
            VerticalAlignment=&quot;Center&quot;
            Orientation=&quot;Horizontal&quot;&gt;
            &lt;Button Click=&quot;myButton_Click&quot;&gt;Click Me&lt;/Button&gt;
        &lt;/StackPanel&gt;
    &lt;/Grid&gt;
&lt;/Window&gt;</x:String>
                    </local:CodeSource.Code>
                </local:CodeSource>
            </local:ControlExample.Xaml>

            <local:ControlExample.Cpp>
                <local:CodeSource>
                    <local:CodeSource.Code>
                        <x:String xml:space="preserve">CustomTitleBar::CustomTitleBar()
{
    ExtendsContentIntoTitleBar(true);
    AppWindow().TitleBar().PreferredHeightOption(winrt::Microsoft::UI::Windowing::TitleBarHeightOption::Tall);
}</x:String>
                    </local:CodeSource.Code>
                </local:CodeSource>
            </local:ControlExample.Cpp>
        </local:ControlExample>

    </StackPanel>
</Page>
