<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUI3Example.StringResourcePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:WinUI3Example"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Style="{StaticResource ControlExamplesStackPanelStyle}">
        <local:ControlExample HeaderText="Using {essential:StringResource} markup extension to simplify localization which would otherwise requires code-behind">
            <StackPanel Spacing="8">
                <Button Content="{essential:StringResource Name=LocalizedButton}" />
                <TextBlock Text="{essential:StringResource Name=LocalizedText}" />
                <Button Click="CreateDialogButton_Click">Click to open ContentDialog</Button>
            </StackPanel>

            <local:ControlExample.Xaml>
                <local:CodeSource>
                    <local:CodeSource.Code>
                        <x:String xml:space="preserve">&lt;Button Content=&quot;{essential:StringResource Name=LocalizedButton}&quot; /&gt;
&lt;TextBlock Text=&quot;{essential:StringResource Name=LocalizedText}&quot; /&gt;

&lt;ContentDialog
    x:Class=&quot;WinUI3Example.LocalizedContentDialog&quot;
    xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;
    xmlns:x=&quot;http://schemas.microsoft.com/winfx/2006/xaml&quot;
    xmlns:d=&quot;http://schemas.microsoft.com/expression/blend/2008&quot;
    xmlns:essential=&quot;using:WinUI3Package&quot;
    xmlns:local=&quot;using:WinUI3Example&quot;
    xmlns:mc=&quot;http://schemas.openxmlformats.org/markup-compatibility/2006&quot;
    Title=&quot;{essential:StringResource Name=LocalizedContentDialogTitle}&quot;
    CloseButtonText=&quot;{essential:StringResource Name=LocalizedContentDialogCloseButtonText}&quot;
    PrimaryButtonText=&quot;{essential:StringResource Name=LocalizedContentDialogPrimaryButtonText}&quot;
    SecondaryButtonText=&quot;{essential:StringResource Name=LocalizedContentDialogSecondaryButtonText}&quot;
    Style=&quot;{StaticResource DefaultContentDialogStyle}&quot;
    mc:Ignorable=&quot;d&quot; /&gt;</x:String>
                    </local:CodeSource.Code>
                </local:CodeSource>
            </local:ControlExample.Xaml>
        </local:ControlExample>

        <local:ControlExample HeaderText="The prime usage for this extension is for properties that are not DependencyProperty and therefore x:Uid cannot be used. They must be set in code-behind, for example Window.Title">
            <Button Click="CreateWindowButton_Click">Create localized Window.TItle</Button>
            <local:ControlExample.Xaml>
                <local:CodeSource>
                    <local:CodeSource.Code>
                        <x:String xml:space="preserve">&lt;Window
    x:Class=&quot;WinUI3Example.LocalizedWindow&quot;
    xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;
    xmlns:x=&quot;http://schemas.microsoft.com/winfx/2006/xaml&quot;
    xmlns:d=&quot;http://schemas.microsoft.com/expression/blend/2008&quot;
    xmlns:essential=&quot;using:WinUI3Package&quot;
    xmlns:local=&quot;using:WinUI3Example&quot;
    xmlns:mc=&quot;http://schemas.openxmlformats.org/markup-compatibility/2006&quot;
    Title=&quot;{essential:StringResource Name=LocalizedWindowTitle}&quot;
    mc:Ignorable=&quot;d&quot;&gt;

    &lt;Button HorizontalAlignment=&quot;Center&quot; VerticalAlignment=&quot;Center&quot;&gt;Button&lt;/Button&gt;
&lt;/Window&gt;</x:String>
                    </local:CodeSource.Code>
                </local:CodeSource>
            </local:ControlExample.Xaml>
        </local:ControlExample>
    </StackPanel>
</Page>
