<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinUI3Example.OriginalWinUI3WindowWithModernToolTip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:WinUI3Example"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="OriginalWinUI3WindowWithModernToolTip"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <essential:ModernWindowCaptionButtonToolTip x:Name="ModernToolTip" Window="{x:Bind}" />
        <TextBlock
            Margin="32"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            FontSize="32"
            Text="Move and hover on these caption buttons to see the ToolTip ↑"
            TextWrapping="WrapWholeWords" />
    </Grid>
</Window>
