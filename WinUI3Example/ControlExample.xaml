                        </Button>
                    </Grid>
                </Expander.Header>

                <local:CodePivot
                    x:Name="CodePivot"
                    Margin="0,-16,0,0"
                    ItemsSource="{x:Bind CodeItems}" />
            </Expander>
        </Grid>
    </Grid>
</UserControl>
