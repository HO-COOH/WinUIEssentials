<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUI3Example.NumberBoxHelperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:WinUI3Example"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Style="{StaticResource ControlExamplesStackPanelStyle}">
        <local:ControlExample HeaderText="Original NumberBox">
            <NumberBox
                Header="Enter an integer:"
                LargeChange="100"
                SmallChange="10"
                SpinButtonPlacementMode="Compact"
                Value="1" />

            <local:ControlExample.Xaml>
                <local:CodeSource>
                    <local:CodeSource.Code>
                        <x:String xml:space="preserve">&lt;NumberBox
    Header=&quot;Enter an integer:&quot;
    LargeChange=&quot;100&quot;
    SmallChange=&quot;10&quot;
    SpinButtonPlacementMode=&quot;Compact&quot;
    Value=&quot;1&quot; /&gt;</x:String>
                    </local:CodeSource.Code>
                </local:CodeSource>
            </local:ControlExample.Xaml>
        </local:ControlExample>

        <local:ControlExample HeaderText="With NumberBoxHelper.AcrylicWorkaround, you got acrylic">
            <NumberBox
                essential:NumberBoxHelper.AcrylicWorkaround="True"
                Header="Enter an integer:"
                LargeChange="100"
                SmallChange="10"
                SpinButtonPlacementMode="Compact"
                Value="1" />

            <local:ControlExample.Xaml>
                <local:CodeSource>
                    <local:CodeSource.Code>
                        <x:String xml:space="preserve">&lt;NumberBox
    essential:NumberBoxHelper.AcrylicWorkaround=&quot;True&quot;
    Header=&quot;Enter an integer:&quot;
    LargeChange=&quot;100&quot;
    SmallChange=&quot;10&quot;
    SpinButtonPlacementMode=&quot;Compact&quot;
    Value=&quot;1&quot; /&gt;</x:String>
                    </local:CodeSource.Code>
                </local:CodeSource>
            </local:ControlExample.Xaml>
        </local:ControlExample>
    </StackPanel>
</Page>
