<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUI3Example.ModernWindowCaptionButtonToolTipPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:WinUI3Example"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <local:ControlExample HeaderText="ModernWindowCaptionButtonToolTip is a helper control that replaces the standard system caption button tooltip with a modern winui3 ToolTip, with Acrylic background">
        <StackPanel Spacing="8">
            <essential:GroupBox Header="Original">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button>Original WinUI3 window</Button>
                    <Button>Original WinUI3 window with ExtendsContentIntoTitleBar</Button>
                </StackPanel>
            </essential:GroupBox>

            <essential:GroupBox Header="With ModernWindowCaptionButtonToolTip">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button>Original WinUI3 window + ModernWindowCaptionButtonToolTip</Button>
                    <Button>Original WinUI3 window with ExtendsContentIntoTitleBar + ModernWindowCaptionButtonToolTip</Button>
                </StackPanel>
            </essential:GroupBox>
        </StackPanel>
    </local:ControlExample>
</Page>
