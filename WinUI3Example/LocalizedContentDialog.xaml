<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="WinUI3Example.LocalizedContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:WinUI3Example"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{essential:StringResource Name=LocalizedContentDialogTitle}"
    CloseButtonText="{essential:StringResource Name=LocalizedContentDialogCloseButtonText}"
    PrimaryButtonText="{essential:StringResource Name=LocalizedContentDialogPrimaryButtonText}"
    SecondaryButtonText="{essential:StringResource Name=LocalizedContentDialogSecondaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d" />
