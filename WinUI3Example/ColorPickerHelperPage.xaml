<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUI3Example.ColorPickerHelperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:WinUI3Example"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Style="{StaticResource ControlExamplesStackPanelStyle}">
        <local:ControlExample HeaderText="Original ColorPicker, you don't have Acrylic in the ToolTip in the ColorSpectrum, Slider and the ComboBox">
            <local:ControlExample.Resources>
                <SolidColorBrush x:Key="ControlExampleDisplayBrush" Color="Transparent" />
                <SolidColorBrush x:Key="GalleryBackgroundBrush" Color="Transparent" />
            </local:ControlExample.Resources>

            <StackPanel Orientation="Horizontal" Spacing="20">
                <ColorPicker IsAlphaEnabled="True" />
                <ColorPicker ColorSpectrumShape="Ring" />
            </StackPanel>

            <local:ControlExample.Xaml>
                <local:CodeSource>
                    <local:CodeSource.Code>
                        <x:String xml:space="preserve">&lt;ColorPicker IsAlphaEnabled=&quot;True&quot; /&gt;
&lt;ColorPicker ColorSpectrumShape=&quot;Ring&quot; /&gt;</x:String>
                    </local:CodeSource.Code>
                </local:CodeSource>
            </local:ControlExample.Xaml>
        </local:ControlExample>

        <local:ControlExample HeaderText="Using ColorPicker.AcrylicWorkaround, you got Acrylic on all those controls">
            <local:ControlExample.Resources>
                <SolidColorBrush x:Key="ControlExampleDisplayBrush" Color="Transparent" />
                <SolidColorBrush x:Key="GalleryBackgroundBrush" Color="Transparent" />
            </local:ControlExample.Resources>

            <StackPanel Orientation="Horizontal" Spacing="20">
                <ColorPicker essential:ColorPickerHelper.AcrylicWorkaround="True" IsAlphaEnabled="True" />
                <ColorPicker essential:ColorPickerHelper.AcrylicWorkaround="True" ColorSpectrumShape="Ring" />
            </StackPanel>

            <local:ControlExample.Xaml>
                <local:CodeSource>
                    <local:CodeSource.Code>
                        <x:String xml:space="preserve">&lt;ColorPicker essential:ColorPickerHelper.AcrylicWorkaround=&quot;True&quot; IsAlphaEnabled=&quot;True&quot; /&gt;
&lt;ColorPicker essential:ColorPickerHelper.AcrylicWorkaround=&quot;True&quot; ColorSpectrumShape=&quot;Ring&quot; /&gt;</x:String>
                    </local:CodeSource.Code>
                </local:CodeSource>
            </local:ControlExample.Xaml>
        </local:ControlExample>
    </StackPanel>
</Page>
