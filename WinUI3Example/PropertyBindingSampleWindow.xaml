<?xml version="1.0" encoding="utf-8" ?>
<essential:WindowEx
    x:Class="WinUI3Example.PropertyBindingSampleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:WinUI3Example"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="PropertyBindingSampleWindow"
    mc:Ignorable="d">

    <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="8">
        <ToggleSwitch
            x:Name="ExtendsContentIntoTitleBarToggle"
            Header="ExtendsContentIntoTitleBar"
            IsOn="{x:Bind ExtendsContentIntoTitleBar, Mode=TwoWay}" />
        <TextBlock>
            <Run>Dpi:</Run>
            <Run Text="{x:Bind Dpi, Mode=OneWay}" />
        </TextBlock>
        <TextBlock>
            <Run>Raw Size:</Run>
            <Run Text="{x:Bind RawWidth, Mode=OneWay}" />
            <Run>,</Run>
            <Run Text="{x:Bind RawHeight, Mode=OneWay}" />
        </TextBlock>
        <CheckBox Content="HasTitleBar" IsChecked="{x:Bind HasTitleBar, Mode=TwoWay}" />
        <CheckBox Content="IsResizable" IsChecked="{x:Bind IsResizable, Mode=TwoWay}" />
        <CheckBox Content="IsAlwaysOnTop" IsChecked="{x:Bind IsAlwaysOnTop, Mode=TwoWay}" />
        <CheckBox Content="IsShownInSwicther" IsChecked="{x:Bind IsShownInSwitcher, Mode=TwoWay}" />
        <RadioButtons
            xmlns:windowing="using:Microsoft.UI.Windowing"
            Header="TitleBarHeight"
            IsEnabled="{x:Bind ExtendsContentIntoTitleBarToggle.IsOn, Mode=OneWay}"
            SelectionChanged="RadioButtons_SelectionChanged">
            <!--  This is currently not working, see https://github.com/microsoft/microsoft-ui-xaml/issues/11554  -->
            <!--<RadioButton Content="Standard">
                <RadioButton.Tag>
                    <windowing:TitleBarHeightOption>Standard</windowing:TitleBarHeightOption>
                </RadioButton.Tag>
            </RadioButton>
            <RadioButton Content="Tall">
                <RadioButton.Tag>
                    <windowing:TitleBarHeightOption>Tall</windowing:TitleBarHeightOption>
                </RadioButton.Tag>
            </RadioButton>
            <RadioButton Content="Collapsed">
                <RadioButton.Tag>
                    <windowing:TitleBarHeightOption>Collapsed</windowing:TitleBarHeightOption>
                </RadioButton.Tag>
            </RadioButton>-->

            <RadioButton Content="Standard" />
            <RadioButton Content="Tall" />
            <RadioButton Content="Collapsed" />
        </RadioButtons>
    </StackPanel>
</essential:WindowEx>
