<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUI3Example.CursorWorkaroundPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:WinUI3Example"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <local:ControlExample HeaderText="CursorController.ApplyCursorWorkaround() is a one-time operation to fix the cursor showing up as a resizing cursor or a spinner cursor when opening a ComboBox / MenuFlyout etc...">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button>
                Right click on this button
                <Button.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="MenuFlyoutItem 1" />
                        <MenuFlyoutItem Text="MenuFlyoutItem 2" />
                        <MenuFlyoutItem Text="MenuFlyoutItem 3" />
                    </MenuFlyout>
                </Button.ContextFlyout>
            </Button>

            <ComboBox
                Width="200"
                VerticalAlignment="Center"
                PlaceholderText="Click to open this ComboBox">
                <x:String>Blue</x:String>
                <x:String>Green</x:String>
                <x:String>Red</x:String>
                <x:String>Yellow</x:String>
            </ComboBox>

            <TextBox
                VerticalAlignment="Center"
                IsReadOnly="True"
                Text="Right click to open menu on this TextBox" />
        </StackPanel>

        <local:ControlExample.Options>
            <ToggleButton
                Click="ToggleButton_Click"
                Content="{x:Bind local:CursorWorkaroundPage.GetButtonText(WorkaroundApplied), Mode=OneWay}"
                IsChecked="{x:Bind WorkaroundApplied, Mode=OneWay}"
                IsEnabled="{x:Bind essential:Convert.ReverseBool(WorkaroundApplied), Mode=OneWay}" />
        </local:ControlExample.Options>

        <local:ControlExample.Cpp>
            <local:CodeSource>
                <local:CodeSource.Code>
                    <x:String xml:space="preserve">winrt::WinUI3Package::CursorController::ApplyCursorWorkaround();</x:String>
                </local:CodeSource.Code>
            </local:CodeSource>
        </local:ControlExample.Cpp>
    </local:ControlExample>
</Page>
